# Server Environment Variables (Development)
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sales_crm

# Places Provider Strategy: 'mock' (default for Phases 1-5) or 'google' (Phase 6 only)
PLACES_PROVIDER=mock

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
