# Server Environment Variables (Development)
NODE_ENV=development
PORT=5000

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/sales_crm

# Places Provider Strategy: 'mock' (default for Phases 1-5) or 'google' (Phase 6 only)
PLACES_PROVIDER=mock

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173

# JWT Configuration
JWT_ACCESS_SECRET=your_jwt_access_secret_key_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Platform Admin Seed Credentials (Optional for CLI seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminSecurePassword123!
ADMIN_FIRST_NAME=Platform
ADMIN_LAST_NAME=Admin
